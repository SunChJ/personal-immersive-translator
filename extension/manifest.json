{
  "manifest_version": 3,
  "name": "Gloss — Immersive Translator",
  "description": "Top-tier bilingual page translation powered by the Gloss macOS app.",
  "version": "0.3.4",
  "version_name": "0.3.4 (PIT 0.2.15)",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gloss — Translate this page"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["route-patch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared.js",
        "content-utils.js",
        "content-state.js",
        "content-detect.js",
        "content-render.js",
        "content-observers.js",
        "content-floating.js",
        "content-selection.js",
        "content-styles.js",
        "content-translate.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "permissions": ["activeTab", "scripting", "storage", "tabs"]
}
